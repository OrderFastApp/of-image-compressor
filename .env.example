# localhost en dev; 0.0.0.0 en producción (default según NODE_ENV)
# HOST=localhost
PORT=3000
MAX_UPLOAD_SIZE_MB=20
MAX_IMAGE_WIDTH=10000
MAX_IMAGE_HEIGHT=10000
DEFAULT_QUALITY=80
DEFAULT_OUTPUT_FORMAT=webp
MAX_VIDEO_UPLOAD_SIZE_MB=200
MAX_VIDEO_DURATION_SECONDS=600
DEFAULT_VIDEO_CRF=28
DEFAULT_VIDEO_OUTPUT_FORMAT=mp4
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
FFMPEG_THREADS=2
# En Docker usar /data/video-temp (volumen en disco). Evitar /tmp si es tmpfs (usa RAM).
# VIDEO_TEMP_DIR=/tmp/of-video-compressor
VIDEO_DOWNLOAD_TTL_SECONDS=1800
# WORKERS=2
LOG_LEVEL=debug
# CORS_ENABLED=true
# Orígenes permitidos: * o lista separada por comas
# CORS_ORIGIN=*
# CORS_ORIGIN=http://localhost:5173,https://app.orderfast.com
# CORS_CREDENTIALS=false
